{
  "name": "dsh-overlay",
  "version": "0.1.36",
  "description": "DSH 插件控制台悬浮窗：随 dsh 启动，两列罗列全部插件+中文名，独立开关，官方判定弹窗，折叠小条，设置/状态诊断/回收站。",
  "main": "main.js",
  "allowScripts": [
    "electron"
  ],
  "scripts": {
    "start": "electron ."
  },
  "author": {
    "name": "LuoqiUile",
    "email": "luoq45697@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dsh.overlay",
    "productName": "DSH插件控制台",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "tray-icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "DSH插件控制台-${version}-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH插件控制台",
      "artifactName": "DSH插件控制台-${version}-${arch}-setup.${ext}"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}